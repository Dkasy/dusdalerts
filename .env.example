# Use an RPC provider that supports eth_getLogs.
# BNB Chain's standard public mainnet endpoints may disable eth_getLogs.
BSC_RPC_URL=

# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=

# Your user/group/channel chat id.
TELEGRAM_CHAT_ID=

# Alert thresholds
LIQUIDITY_DROP_PCT=10
WHALE_USD_THRESHOLD=50000
DEPEG_THRESHOLD=0.998
DEPEG_REARM=0.999

# Monitoring behavior
POLL_SECONDS=2
CONFIRMATIONS=2
LOG_BLOCK_CHUNK=200
MAX_BACKFILL_BLOCKS=10000
SEND_STARTUP_MESSAGE=true
LOG_LEVEL=INFO

# Optional
# STATE_FILE=/var/lib/dusd-monitor/state.json
